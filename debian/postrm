#!/bin/sh
set -eu

# Restore a partial backup if dpkg unwinds a failed legacy upgrade.
case "${1:-}" in
    abort-install|abort-upgrade|failed-upgrade)
        root=${DPKG_ROOT:-}
        backup="$root/var/lib/ukui-notebook/legacy-postrm-backup"
        if [ -d "$backup" ]; then
            for saved in "$backup"/home/*/.config/ukui/Clock_database.db \
                         "$backup"/home/*/.config/ukui/url.conf; do
                [ -f "$saved" ] || [ -L "$saved" ] || continue
                relative=${saved#"$backup"/}
                file="$root/$relative"
                if [ ! -e "$file" ] && [ ! -L "$file" ]; then
                    mkdir -p "$(dirname "$file")"
                    cp -a -- "$saved" "$file"
                fi
            done
            rm -rf -- "$backup"
        fi
        ;;
esac

#DEBHELPER#
